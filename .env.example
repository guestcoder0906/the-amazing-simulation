# CLAUDE_API_KEY: the site's shared Anthropic Claude API key, used when a visitor has not entered their own key
# ("Continue without custom key (limits apply)"). On Vercel: Project Settings -> Environment Variables.
# Locally: put it in .env.local. Only the serverless function api/claude.ts reads it; it never reaches the browser.
CLAUDE_API_KEY="MY_CLAUDE_API_KEY"
# Optional per-visitor caps for the shared key (unset or 0 = no app-side cap):
# SHARED_LIMIT_PER_10MIN=
# SHARED_LIMIT_PER_DAY=

# GEMINI_API_KEY: Google Gemini key for quick tasks (talking, moving, looking, reactions) and all audio listening
# (voice chat + live game sound), using gemini-3.5-flash-lite with minimal thinking. Read only by api/gemini.ts.
# Without it, quick tasks fall back to Claude Haiku 5.5 and listening is off.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
