# CLAUDE_API_KEY: Optional shared Anthropic Claude API key used when visitors choose
# "Continue without custom key (limits apply)". On Vercel, add it under
# Project Settings -> Environment Variables. Locally, put it in .env.local.
# It is only read by the serverless function api/claude.ts and never sent to the browser.
CLAUDE_API_KEY="MY_CLAUDE_API_KEY"
